module multiplicador8bit_alternativo(
    input clk,
    input reset,
    input start,
    input [7:0] A, B,
    output [15:0] out,
    output done
);
    wire [15:0] acc, acc_next;
    wire [7:0] count;
    wire carry;
    wire cont_enable;
    wire count_done;

    // -------------------------------------
    // Contador até 255
    // -------------------------------------
    contador_mod255 ctr(
        .en(cont_enable),
        .reset(reset),
        .out_0(count[0]),
        .out_1(count[1]),
        .out_2(count[2]),
        .out_3(count[3]),
        .out_4(count[4]),
        .out_5(count[5]),
        .out_6(count[6]),
        .out_7(count[7])
    );

    // -------------------------------------
    // Comparador para parar quando count == B
    // -------------------------------------
    comparador_8bit cmp(
        .equal(count_done),
        .A(count),
        .B(B)
    );

    // -------------------------------------
    // Somador de 16 bits: acc_next = acc + A
    // -------------------------------------
    sum16bit sum(
        .Cout(carry),
        .S(acc_next),
        .A(acc),
        .B({8'b0, A})  // extendendo A para 16 bits
    );

    // -------------------------------------
    // Registrador de acumulador (16 bits)
    // -------------------------------------
    wire enable_acc;
    and(enable_acc, start, ~count_done); // habilita apenas se não terminou

    register_16bit reg_acc(
        .in(acc_next),
        .en(enable_acc),
        .out(acc),
        .reset(reset)
    );

    // -------------------------------------
    // Saída
    // -------------------------------------
    buf(out[0], acc[0]);
    buf(out[1], acc[1]);
    buf(out[2], acc[2]);
    buf(out[3], acc[3]);
    buf(out[4], acc[4]);
    buf(out[5], acc[5]);
    buf(out[6], acc[6]);
    buf(out[7], acc[7]);
    buf(out[8], acc[8]);
    buf(out[9], acc[9]);
    buf(out[10], acc[10]);
    buf(out[11], acc[11]);
    buf(out[12], acc[12]);
    buf(out[13], acc[13]);
    buf(out[14], acc[14]);
    buf(out[15], acc[15]);

    // done = 1 enquanto ainda somando
    not(done, count_done);

    // -------------------------------------
    // Enable do contador
    // -------------------------------------
    buf(cont_enable, enable_acc);
endmodule
