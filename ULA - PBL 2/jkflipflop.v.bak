module jkfflipflop (
    input wire j,
    input wire k,
    input wire clk,
    input wire ena,   // clock enable
    input wire clrn,  // clear assíncrono
    output wire q
);

// JKFF com enable
jkffe jkffe_inst (
    .j(j),
    .k(k),
    .clk(clk),
    .ena(ena),
    .clrn(clrn),
    .prn(1'b1),      // preset não utilizado
    .q(q)
);

endmodule