module contador_mod4(en, reset, out);
    input en;
    input reset;
    output [1:0] out;
    
    // Fios para as entradas D dos flip-flops (os ~out)
    wire not_out0, not_out1;
    
    // Portas NOT para cada bit
    not not0(not_out0, out[0]);
    not not1(not_out1, out[1]);
    
    // Conexão direta entre estágios com portas NOT explícitas
    d_flipflop dff0 (.q(out[0]), .d(not_out0), .reset(reset), .clk(en));
    d_flipflop dff1 (.q(out[1]), .d(not_out1), .reset(reset), .clk(not_out0));
	 
endmodule