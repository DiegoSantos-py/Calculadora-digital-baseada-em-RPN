module mux_divisor(out, A, B, sel);
	input sel;
	input [7:0]A;
	input [7:0]B;
	output [7:0]out;
	
	mux1 mux01(out[0], A[0], B[0], sel);
	mux1 mux02(out[1], A[1], B[1], sel);
	mux1 mux03(out[2], A[2], B[2], sel);
	mux1 mux04(out[3], A[3], B[3], sel);
	mux1 mux05(out[4], A[4], B[4], sel);
	mux1 mux06(out[5], A[5], B[5], sel);
	mux1 mux07(out[6], A[6], B[6], sel);
	mux1 mux08(out[7], A[7], B[7], sel);
endmodule

module divisor8bit(S, A, B);
	input [7:0]A;
	input [7:0]B;
	output [7:0]S;

    wire bout0, bout1, bout2, bout3;
    wire [7:0] subout0, subout1, subout2, subout3;
    wire [7:0] prev0, prev1, prev2, prev3, prev4, prev5, prev6;

    sub8bit sub0(.A({6'b000, A[7]}), .B(B), .bin(1'b0), .S(subout0), .bout(bout0));
    mux_divisor mux0 (.sel(bout0), .A(subout0), .B({3'b000, A[7]}), .out(prev0));
    not(Q[7], bout0);

	 sub8bit sub1(.A({prev0[6:0], A[6]}), .B(B), .bin(1'b0), .S(subout1), .bout(bout1));
    mux_divisor mux1 (.sel(bout1), .X(subout1), .Y({prev0[6:0], A[6]}), .S(prev1));
    not(Q[6], bout1);

	 sub8bit sub2(.A({prev1[6:0], A[5]}), .B(B), .bin(1'b0), .S(subout2), .bout(bout2));
    mux_divisor mux2 (.sel(bout2), .X(subout2), .Y({prev1[6:0], A[5]}), .S(prev2));
    not(Q[5], bout2);
	 
	 sub8bit sub3(.A({prev2[6:0], A[4]}), .B(B), .bin(1'b0), .S(subout3), .bout(bout3));
    mux_divisor mux3 (.sel(bout3), .X(subout3), .Y({prev2[6:0], A[4]}), .S(prev3));
    not(Q[4], bout3);
	 
	 sub8bit sub4(.A({prev3[6:0], A[3]}), .B(B), .bin(1'b0), .S(subout4), .bout(bout4));
    mux_divisor mux4 (.sel(bout4), .X(subout4), .Y({prev3[6:0], A[3]}), .S(prev4));
    not(Q[3], bout4);
	 
	 sub8bit sub5(.A({prev4[6:0], A[2]}), .B(B), .bin(1'b0), .S(subout5), .bout(bout5));
    mux_divisor mux5 (.sel(bout5), .X(subout5), .Y({prev4[6:0], A[2]}), .S(prev5));
    not(Q[2], bout5);
	 
	 sub8bit sub6(.A({prev5[6:0], A[1]}), .B(B), .bin(1'b0), .S(subout6), .bout(bout6));
    mux_divisor mux6 (.sel(bout6), .X(subout6), .Y({prev5[6:0], A[1]}), .S(prev6));
    not(Q[1], bout6);
	 
	 sub8bit sub7(.A({prev6[6:0], A[0]}), .B(B), .bin(1'b0), .S(subout7), .bout(bout7));
    mux_divisor mux6 (.sel(bout7), .X(subout7), .Y({prev6[6:0], A[0]}), .S(prev7));
    not(Q[0], bout7);
	 
endmodule