module modulo_controle(
    input clk,
    input reset,
    output enable,   // Ativo em clocks 1,3,5,...
    output control   // Ativo em clocks 2,4,6,...
);
    wire q0, q1;
    wire nq0, nq1;

    // Flip-flop para alternar enable
    not(nq0, q0);
    d_flipflop ff0(
        .q(q0),
        .d(nq0),
        .clk(clk),
        .reset(reset)
    );

    // Flip-flop para gerar controle nos clocks pares
    not(nq1, q1);
    d_flipflop ff1(
        .q(q1),
        .d(nq1),
        .clk(q0),   // avança a cada mudança de q0
        .reset(reset)
    );

    // Saídas
    buf(enable, q0);            // enable alternado: 1,0,1,0…
    and(control, q1, ~q0);      // control nos clocks pares: 0,1,0,1…
endmodule
