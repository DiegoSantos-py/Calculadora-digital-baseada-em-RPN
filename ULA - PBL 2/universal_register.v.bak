module universal_register(in_serie, in_paralelo, en, out, control, reset);                
	input [16:0]in_paralelo;
	input in_serie;
	input en;
	input control;
	input reset;
	output [16:0]out;
	 
	wire [16:0] data;
	
	mux2x1(data[0], in_paralelo[0], in_serie, control);
	d_flipflop dff0 (.q(out[0]), .d(data[0]), .reset(reset), .clk(en));
	
	mux2x1(data[1], in_paralelo[1], out[0], control);
	d_flipflop dff1 (.q(out[1]), .d(data[1]), .reset(reset), .clk(en));
	
	mux2x1(data[2], in_paralelo[2], out[1], control);
	d_flipflop dff2 (.q(out[2]), .d(data[2]), .reset(reset), .clk(en));
	
	mux2x1(data[3], in_paralelo[3], out[2], control);
	d_flipflop dff3 (.q(out[3]), .d(data[3]), .reset(reset), .clk(en));
	
	mux2x1(data[4], in_paralelo[4], out[3], control);
	d_flipflop dff4 (.q(out[4]), .d(data[4]), .reset(reset), .clk(en));
	
	mux2x1(data[5], in_paralelo[5], out[4], control);
	d_flipflop dff5 (.q(out[5]), .d(data[5]), .reset(reset), .clk(en));
	
	mux2x1(data[6], in_paralelo[6], out[5], control);
	d_flipflop dff6 (.q(out[6]), .d(data[6]), .reset(reset), .clk(en));
	
	mux2x1(data[7], in_paralelo[7], out[6], control);
	d_flipflop dff7 (.q(out[7]), .d(data[7]), .reset(reset), .clk(en));
	
	mux2x1(data[8], in_paralelo[8], out[7], control);
	d_flipflop dff8 (.q(out[8]), .d(data[8]), .reset(reset), .clk(en));
	
	mux2x1(data[9], in_paralelo[9], out[8], control);
	d_flipflop dff9 (.q(out[9]), .d(data[9]), .reset(reset), .clk(en));
	
	mux2x1(data[10], in_paralelo[10], out[9], control);
	d_flipflop dff10 (.q(out[10]), .d(data[10]), .reset(reset), .clk(en));
	
	mux2x1(data[11], in_paralelo[11], out[10], control);
	d_flipflop dff11 (.q(out[11]), .d(data[11]), .reset(reset), .clk(en));
	
	mux2x1(data[12], in_paralelo[12], out[11], control);
	d_flipflop dff12 (.q(out[12]), .d(data[12]), .reset(reset), .clk(en));
	
	mux2x1(data[13], in_paralelo[13], out[12], control);
	d_flipflop dff13 (.q(out[13]), .d(data[13]), .reset(reset), .clk(en));
	
	mux2x1(data[14], in_paralelo[14], out[13], control);
	d_flipflop dff14 (.q(out[14]), .d(data[14]), .reset(reset), .clk(en));
	
	mux2x1(data[15], in_paralelo[15], out[14], control);
	d_flipflop dff15 (.q(out[15]), .d(data[15]), .reset(reset), .clk(en));
	 
	mux2x1(data[16], in_paralelo[16], out[15], control);
	d_flipflop dff16 (.q(out[16]), .d(data[16]), .reset(reset), .clk(en));
	 
endmodule